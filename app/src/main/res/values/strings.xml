    <!-- About -->
    <string name="about_title">About &amp; privacy</string>
    <string name="about_body">CDNHunter Pro discovers, scans and ranks CDN edge IPs that work well as CDN-fronting candidates, and exports them in client-compatible formats. It is a network diagnostic tool: it never creates a VPN, never intercepts other apps\' traffic and never installs certificates.</string>
    <string name="version">Version %1$s</string>
    <string name="github_repo">GitHub repository</string>
    <string name="license_note">Licensed under MIT. Third-party libraries: AndroidX/Compose/Room/OkHttp/ZXing (Apache-2.0), Kotlin Coroutines &amp; Serialization (Apache-2.0).</string>
    <string name="report_security">Report a security issue: open a private security advisory on the GitHub repository.</string>
    <string name="privacy_full_title">Privacy policy</string>
    <string name="privacy_full_body">• Scan results, ranges and settings are stored locally in the app database.\n• Nothing is uploaded to any server by the app.\n• Error logs never contain tokens, credentials or browsing data.\n• You can delete all data from Settings → Clear all local data.\n• The app only requests INTERNET and ACCESS_NETWORK_STATE permissions.</string>
    <string name="limitations_title">Known limitations</string>
    <string name="limitations_body">• “Verified compatible” means TLS+SNI+HTTP tests passed on that IP; it does not guarantee a specific proxy client tunnel will work.\n• HTTP/3 is not tested (network stack limitation).\n• IPv6 ranges are parsed and can be imported, but scanning samples only a tiny subset of huge IPv6 blocks.\n• Azure source URL changes weekly upstream; keep it updated in Advanced settings.\n• Results expire (default 72h) and should be re-tested before long-term use.</string>
    <string name="real_data_note">The dashboard shows only real measurements from your own scans — no demo data.</string>

